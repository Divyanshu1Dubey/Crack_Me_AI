# Razorpay (REQUIRED for production payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Client IP behind the platform proxy (rate limiting) ─────────────
# Behind DigitalOcean App Platform / Cloudflare, REMOTE_ADDR is the proxy and
# is shared by every visitor. Until one of these is set, the question-bank
# limiter counts all anonymous traffic in the proxy's bucket and DRF's anon
# throttles key on the client-supplied X-Forwarded-For (the app logs a
# warning at startup). Check what the edge sends first: signed in as an
# admin, open /api/health/client-ip/ on the deployed API.
# Header the edge sets to the client address -- only if Django cannot be
# reached around that edge (clients could forge it otherwise), e.g.
# DO-Connecting-IP (App Platform) or CF-Connecting-IP (Cloudflare proxy):
TRUSTED_CLIENT_IP_HEADER=
# Proxies that append to X-Forwarded-For in front of gunicorn (usually 1:
# X-Forwarded-For ends with your own address). DRF's throttles read only
# this one, so set it as well:
NUM_PROXIES=
# Question-bank limiter: GETs under /api/questions/ per user (or per client
# IP when anonymous) per window; 0 disables it.
QUESTION_BANK_RATE_LIMIT=300
QUESTION_BANK_RATE_WINDOW=60
# Entries kept by the limiter's own LocMem cache when REDIS_URL is unset.
RATE_LIMIT_CACHE_MAX_ENTRIES=50000

# Only use LFS for the massive textbooks (above 100MB) and sqlite database
**/textbooks/*.pdf filter=lfs diff=lfs merge=lfs -text
**/Ghai*Pediatrics*.pdf filter=lfs diff=lfs merge=lfs -text
**/Nelson*Pediatrics*.pdf filter=lfs diff=lfs merge=lfs -text
*.sqlite3 filter=lfs diff=lfs merge=lfs -text
# Shell scripts run with bash on Linux hosts (Railway release.sh / start_web.sh):
# keep LF even in Windows checkouts (core.autocrlf would add CR and break bash).
*.sh text eol=lf

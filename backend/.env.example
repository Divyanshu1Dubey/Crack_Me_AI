# Core Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend origin for links and CORS/CSRF
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Database (Supabase Postgres)
# Replace [YOUR-PASSWORD] with your Supabase database password.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.ryuvcdthjnxyetdyjbph.supabase.co:5432/postgres
# Transaction-mode poolers (PgBouncer, Supabase port 6543) cannot hold server-side
# cursors. Empty = automatic (disabled for port 6543); set true for any other
# transaction-mode pooler, false to force them on.
DB_DISABLE_SERVER_SIDE_CURSORS=

# Optional: mirror Django registrations into Supabase Auth (auth.users)
SUPABASE_AUTH_MIRROR_ENABLED=false
SUPABASE_URL=https://ryuvcdthjnxyetdyjbph.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Public key the backend uses to verify Supabase access tokens: the same value
# as the frontend's NEXT_PUBLIC_SUPABASE_ANON_KEY (SUPABASE_PUBLISHABLE_KEY or
# SUPABASE_AUTH_VERIFY_KEY also work). Without it the service-role key is sent
# as the apikey (manage.py check --deploy: accounts.W002).
SUPABASE_ANON_KEY=
# Set to true only after turning ON Supabase Auth "Confirm email" and "Secure
# email change" (dashboard: Authentication -> Sign In / Providers -> Email).
# First-sign-in account linking and the admin email allowlist trust the email
# Supabase reports, so both must be on (accounts.W001 until this is true).
SUPABASE_EMAIL_CONFIRMATION_ENABLED=false
# File on a PERSISTENT volume for the admin "Backup data" / "Restore data"
# tools. Container disks are wiped on redeploy, so production refuses those
# tools without it (accounts.W003).
CORE_DATA_BACKUP_PATH=

# Email (Gmail SMTP for password reset emails)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=CrackCMS <your-email@gmail.com>
EMAIL_TIMEOUT=20

# Optional AI keys
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
CEREBRAS_API_KEY=
COHERE_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_API_KEY2=
TOGETHER_API_KEY=
GITHUB_TOKEN=
HUGGINGFACE_API_KEY=
AIML_API_KEY=
MISTRAL_API_KEY=
NVIDIA_MISTRAL_API_KEY=

# OmniRoute Gateway (OpenAI-compatible proxy - routes to all providers)
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=https://omniroute-production-9d6b.up.railway.app/v1

# Razorpay (REQUIRED for production payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Client IP behind the platform proxy (rate limiting) ─────────────
# Behind DigitalOcean App Platform / Cloudflare, REMOTE_ADDR is the proxy and
# is shared by every visitor. Until one of these is set, the question-bank
# limiter counts all anonymous traffic in the proxy's bucket and DRF's anon
# throttles key on the client-supplied X-Forwarded-For (the app logs a
# warning at startup). Check what the edge sends first: signed in as an
# admin, open /api/health/client-ip/ on the deployed API.
# Header the edge sets to the client address -- only if Django cannot be
# reached around that edge (clients could forge it otherwise). On DigitalOcean
# App Platform use DO-Connecting-IP: the public *.ondigitalocean.app hostname
# bypasses any Cloudflare proxy, so CF-Connecting-IP can be forged there. Use
# CF-Connecting-IP only when every request is forced through Cloudflare.
TRUSTED_CLIENT_IP_HEADER=
# The one edge header analytics ingest reads the visitor's country from (e.g.
# CF-IPCountry, X-Vercel-IP-Country, CloudFront-Viewer-Country). Empty = the
# country header of the edge named by TRUSTED_CLIENT_IP_HEADER, else
# CF-IPCountry; 'none' stores no country.
ANALYTICS_COUNTRY_HEADER=
# Proxies that append to X-Forwarded-For in front of gunicorn (usually 1:
# X-Forwarded-For ends with your own address). DRF's throttles read only
# this one, so set it as well:
NUM_PROXIES=
# Question-bank limiter: GETs under /api/questions/ per user (or per client
# IP when anonymous) per window; 0 disables it.
QUESTION_BANK_RATE_LIMIT=300
QUESTION_BANK_RATE_WINDOW=60
# Import/ingestion recovery (runs on the qcluster worker): minutes between
# stale-job recovery passes (0 removes the schedule) and how many times one
# job may be resumed automatically (0 = never).
INGESTION_RECOVERY_SCHEDULE_MINUTES=10
INGESTION_MAX_AUTO_RESUMES=2
# Entries kept by the limiter's own LocMem cache when REDIS_URL is unset.
RATE_LIMIT_CACHE_MAX_ENTRIES=50000

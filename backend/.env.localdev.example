# Local development environment for the restored CrackLabs stack.
#
# Generate the real file with:  python scripts/local/make_env_localdev.py
# (writes backend/.env.localdev with fresh random secrets; gitignored).
# The backend loads it when started with DJANGO_ENV_FILE=.env.localdev,
# which scripts/local/start-local.ps1 does for you. The production `.env`
# (live SMTP / Razorpay / Supabase / Sentry credentials) is NOT loaded.

DEBUG=True
DJANGO_SECRET_KEY=__generated__
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Isolated Postgres cluster restored from the Supabase backup (port 55432).
DATABASE_URL=postgres://crack_super@127.0.0.1:55432/crack_local
# runserver opens a thread per request; persistent connections would
# exhaust max_connections under parallel load, so close per request locally.
CONN_MAX_AGE=0

# Restored media (recall_images etc.) and Supabase Storage mirror.
MEDIA_ROOT=C:/Users/DIVYANSHU/crack_local/media
SUPABASE_STORAGE_MIRROR_DIR=C:/Users/DIVYANSHU/crack_local/storage

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Never send real mail locally: messages are written to files.
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_FILE_PATH=C:/Users/DIVYANSHU/crack_local/mail

# No error reporting to the production Sentry project.
SENTRY_DSN=

# Dev-only email/password auth (Supabase is not used locally). Refused
# unless DEBUG=True; see accounts/local_auth.py.
LOCAL_DEV_AUTH=1
# Password for the seeded local test accounts (student/premium/admin@local.test);
# read it from your generated backend/.env.localdev.
LOCAL_SEED_PASSWORD=__generated__

# Payments: local mock provider (no network, no real money). Refused
# unless DEBUG=True; see accounts/payments_mock.py.
PAYMENTS_MODE=mock
RAZORPAY_KEY_ID=rzp_test_localmock
RAZORPAY_KEY_SECRET=__generated__
RAZORPAY_WEBHOOK_SECRET=__generated__

# AI: set AI_OFFLINE_MODE=1 to answer from retrieved context only (no
# external LLM calls). Provider keys are optional and copied from .env by
# the generator only when you pass --with-ai-keys.
AI_OFFLINE_MODE=0

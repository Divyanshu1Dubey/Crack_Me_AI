# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg

# Django media (user-uploaded; regenerated by importer)
backend/media/


# Virtual environment
venv/
.venv/
env/

# Environment variables
.env
.env.local
.env.production
# Any other env variant (e.g. .env.supabase.local) holds real credentials;
# only the committed *.example templates are allowed.
.env.*
!.env*.example

# Node / Next.js
node_modules/
.next/
out/
frontend/.next/
frontend/node_modules/

# IDE
.vscode/
!.vscode/
.vscode/*
!.vscode/mcp.json
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Database (ignore generated sqlite3, but keep deployed ones)
*.sqlite3
!backend/db.sqlite3
!backend/chroma_db/chroma.sqlite3
!backend/chroma_db/rag_store.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Logs
*.log
backend/test_out/

# Generated test artifacts
frontend/playwright-report/
frontend/test-results/
.playwright-mcp/

# Backend ad-hoc output artifacts
backend/test_out.txt
backend/test_api_keys_output.txt

# Temporary keys, images & scratch workspace
backend/RECOVERED_KEYS.txt
backend/*.jpeg
backend/*.jpg
backend/*.png
backend/scratch/

# Local Claude Code session state
.claude/
graphify-out/

# Imported massive directories
tesseract/
backend/importers/neetpg/_output/

# Production Ingestion Platform (Phase 1) — generated per-job artefact trees
backend/_artifacts_ingestion/
backend/_artifacts/
backend/_artifacts_benchmark_post_fix/
backend/_audit_sample.json
backend/_run_benchmark.py

# Local Tesseract / OCR tool installations (large binaries). Anchored to the
# repo root so it does not hide new pages under frontend/src/app/tools/.
/tools/

.superpowers/

# Private / customer-owned content (NEVER commit — public repo exposure risk)
backend/postgres/
cms_exclusive_material/

# Audit session notes (kept locally, not part of codebase)
_audit_session_notes.md

# Local Postgres dumps (db.sqlite3 already gitignored, but block pg_dumpall output)
*.dump
*.sql.gz
postgres/

# Personal-data / database dumps: NEVER commit. They hold user emails, phones,
# IPs, password hashes, sessions and payment ids. Keep backups encrypted and
# outside the repository (removed from the tree 2026-11-01).
db_dumps/
data_dump*.json
*_full_dump*.json
supabase_auth_users*.json
backup/sql/*.sql
!backup/sql/copy_questionimage.sql

# Local development (generated, contains local secrets)
.env.localdev
backend/.env.localdev
backend/tmp_mail/
